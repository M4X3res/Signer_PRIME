# Environment variables for development

# Database (for full implementation)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/signer_license

# Cloud SQL (for production)
DB_CONNECTION_NAME=project:region:instance
DB_USER=signer_app
DB_NAME=signer_license
DB_PASSWORD=<from Secret Manager>

# Crypto
ED25519_PRIVATE_KEY_PEM=<from Secret Manager or .deploy_keys/>

# Admin API
ADMIN_API_KEY=dev-admin-key-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server
PORT=8080
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
