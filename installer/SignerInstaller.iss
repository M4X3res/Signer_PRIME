Name: "{group}\{cm:UninstallProgram,Signer}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\Signer"; Filename: "{app}\Signer\Signer.exe"; WorkingDir: "{app}\Signer"; Tasks: desktopicon

[UninstallDelete]
